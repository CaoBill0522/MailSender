[Unit]
Description=MailSender SMTP rotation service
After=network-online.target
Wants=network-online.target

[Service]
User=mailsender
Group=mailsender
Environment=MS_DATA_DIR=/var/lib/mailsender
# Ports, TLS and other options: see README "配置"
EnvironmentFile=-/etc/mailsender.env
ExecStart=/usr/local/bin/mailsender
Restart=on-failure
RestartSec=3

# allow binding 443/465/587 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/mailsender

[Install]
WantedBy=multi-user.target
